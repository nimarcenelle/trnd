# Supabase: Project Settings → API. Paste supabase/setup.sql into the SQL editor once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: reads each account, tags videos, writes the weekly plan.
OPENAI_API_KEY=
# Optional model pin (default gpt-5.5).
OPENAI_MODEL=

# Apify: every public TikTok read (profiles, hashtags). Required.
APIFY_TOKEN=
# Optional override (default clockworks~tiktok-scraper).
APIFY_TIKTOK_ACTOR=
# Optional: an actor that reads TikTok Creative Center's trending hashtags. Unset,
# trends come only from the niche videos we read. See DATA.md.
APIFY_TIKTOK_TRENDS_ACTOR=

# TikTok Login Kit (developers.tiktok.com), for "Connect TikTok". Optional; needs
# TikTok's app review for production. Redirect URI: <site>/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Bearer token for /api/cron/scan; Vercel Cron sends it automatically.
CRON_SECRET=

# Public URL of the site (auth redirects, email links, scan hand-offs).
NEXT_PUBLIC_SITE_URL=

# Stripe: one subscription price. Webhook: POST /api/stripe/webhook
# (checkout.session.completed, customer.subscription.updated/deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE=

# Resend: the weekly plan email.
RESEND_API_KEY=
EMAIL_FROM=
