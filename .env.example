# Supabase: Project Settings → API. Run supabase/migrations/0100_surveillance.sql once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: names the rivals, tags each ad, writes the reports.
OPENAI_API_KEY=
# Optional model pin (default gpt-5.5).
OPENAI_MODEL=

# Optional. The Ad Library is read directly; if Meta walls the server's IP,
# the same search falls back to this Apify actor (about $1 per 1,000 ads).
APIFY_TOKEN=
APIFY_ADLIBRARY_ACTOR=
# Ads read per rival per scan (default 50, max 200).
ADS_PER_RIVAL=

# Bearer token for /api/cron/scan; Vercel Cron sends it automatically.
CRON_SECRET=

# Public URL of the site (auth redirects, email links).
NEXT_PUBLIC_SITE_URL=

# Stripe: one subscription price. Webhook: POST /api/stripe/webhook
# (checkout.session.completed, customer.subscription.updated/deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE=

# Resend: the "your rivals changed their ads" email.
RESEND_API_KEY=
EMAIL_FROM=
