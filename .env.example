# Supabase — project URL + keys from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — https://platform.openai.com/api-keys. Every model-written read
# (the founding analysis, the strategist pass, the briefs, document digests)
# switches on with this key; without it the deterministic templates run.
OPENAI_API_KEY=
# Optional: pin the two model tiers. Unset, the newest general model and the
# newest small model on the account are resolved at first use (lib/ai/openai.ts).
OPENAI_MODEL_PRO=
OPENAI_MODEL_FLASH=

# Optional; the YouTube signal adapter is skipped if absent
YOUTUBE_API_KEY=
# Per-term TikTok (paid, per result). Without it TikTok is the free
# national Creative Center board only.
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=
# Optional actor overrides for the social and rival-ad reads (defaults in
# lib/social/* and lib/signals/adlibrary-apify.ts).
APIFY_INSTAGRAM_ACTOR=
APIFY_FACEBOOK_ACTOR=
APIFY_ADLIBRARY_ACTOR=
APIFY_GOOGLE_ADS_ACTOR=
# X recent search (paid tier — no keyless read access exists).
X_BEARER_TOKEN=
# Instagram, read as OUR OWN professional account. With these two set, every
# brand's and rival's public Instagram posts are read free through Meta's
# Business Discovery endpoint (no App Review: the reader is our account, which
# has a role on the app) and the paid Apify profile actor is only a fallback.
# How to get them (10 minutes, once):
#   1. developers.facebook.com → the TRND app → add the "Instagram" product.
#   2. Under "Instagram API with Instagram Login" → "Generate access tokens",
#      add your own Instagram professional account (Business or Creator) as
#      an Instagram Tester / app role, then Generate. The long-lived token
#      starts "IGAA…" and lasts 60 days.
#   3. INSTAGRAM_BUSINESS_ID is that account's id, shown next to the token
#      (or GET https://graph.instagram.com/v21.0/me?fields=id&access_token=…).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Reddit public JSON requires a descriptive User-Agent or it 429s
REDDIT_USER_AGENT=trnd-signal/0.1 (by /u/trnd)
# Reddit's official API (free, 100 requests a minute): a "script" app's id and
# secret from reddit.com/prefs/apps. Without them the public JSON endpoints are
# tried, which answer 403 from cloud IPs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bearer token protecting /api/cron/* — set the same value in Vercel Cron
CRON_SECRET=

# Public URL of the deployed site (used for magic-link redirects, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=

# Stripe — billing switches on with the secret key + baseline price id.
# Webhook endpoint: POST /api/stripe/webhook (checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASELINE=
STRIPE_PRICE_PRO=

# Founder notifications — demo requests + new signups pushed where you look.
# Either (or both): a Slack/Discord/Zapier-style webhook, and/or email via Resend.
NOTIFY_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Founder-assisted pilot. When set, /signup asks for this code and the home
# page sends everyone else to the application form, so a paid scan runs only
# for a brand the founder has talked to. Leave unset for open signup.
PILOT_INVITE_CODE=

# Internal growth tools (/admin/prospector). Legacy local-business outreach,
# outside the pilot funnel; nothing schedules it and sends need a click. ADMIN_EMAILS restricts the page
# to comma-separated sign-in emails; unset means any signed-in user gets in.
# OUTREACH_FROM is the founder sender for prospect emails (falls back to
# EMAIL_FROM). Discovery reuses GOOGLE_PLACES_API_KEY.
ADMIN_EMAILS=
OUTREACH_FROM=
