# Supabase: Project Settings → API. Paste supabase/setup.sql into the SQL editor once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: reads each account, tags videos, writes the weekly plan.
OPENAI_API_KEY=
# Optional model pin (default gpt-5.5).
OPENAI_MODEL=

# Apify: every public TikTok read (profiles, hashtags). Required.
APIFY_TOKEN=
# Optional override (default clockworks~tiktok-scraper).
APIFY_TIKTOK_ACTOR=
# Optional: an actor that reads TikTok Creative Center's trending hashtags. Unset,
# trends come only from the niche videos we read. See DATA.md.
APIFY_TIKTOK_TRENDS_ACTOR=

# TikTok Login Kit (developers.tiktok.com), for "Connect TikTok". Optional; needs
# TikTok's app review for production. Redirect URI: <site>/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Free previews (results before sign-up). Each costs an Apify read and two model
# calls; previews are reused per handle for 72 hours. Daily cap across all visitors
# (default 300); past it, visitors are sent to sign up instead.
PREVIEW_DAILY_CAP=
# Optional Cloudflare Turnstile on the handle box (bot check). Both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# "Continue with Google" on sign-up and sign-in: set to 1 once the Google provider
# is on in Supabase (see supabase/email-templates/README.md).
NEXT_PUBLIC_GOOGLE_AUTH=

# The trial takes a card at the start (default). Set to 0 for a 14-day trial
# without a card from sign-up instead.
TRIAL_REQUIRES_CARD=

# Bearer token for /api/cron/scan; Vercel Cron sends it automatically.
CRON_SECRET=

# Public URL of the site (auth redirects, email links, scan hand-offs).
NEXT_PUBLIC_SITE_URL=

# Stripe: two recurring prices for the same plan, $9.99/week and $24.99/month. Webhook: POST /api/stripe/webhook
# (checkout.session.completed, customer.subscription.updated/deleted/trial_will_end).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=

# Resend: the weekly plan email.
RESEND_API_KEY=
EMAIL_FROM=
