# Supabase — project URL + keys from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional; the YouTube signal adapter is skipped if absent
YOUTUBE_API_KEY=
# Per-term TikTok (paid, per result). Without it TikTok is the free
# national Creative Center board only.
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=
# Optional actor overrides for the social and rival-ad reads (defaults in
# lib/social/* and lib/signals/adlibrary-apify.ts).
APIFY_INSTAGRAM_ACTOR=
APIFY_FACEBOOK_ACTOR=
APIFY_ADLIBRARY_ACTOR=
APIFY_GOOGLE_ADS_ACTOR=
# X recent search (paid tier — no keyless read access exists).
X_BEARER_TOKEN=
# Instagram Reels per hashtag. Needs an IG Business account linked to a
# Facebook Page and App Review for instagram_basic. 30 hashtags / 7 days.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Set to 1 only AFTER Meta App Review approves instagram_basic.
META_INSTAGRAM_SCOPES=

# Meta Marketing API app — ad-account connect, results sync, launch.
META_APP_ID=
META_APP_SECRET=

# Google Ads OAuth + developer token. Seam only; sync ships Meta-first.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Google Places — own and competitor ratings, review text, and the
# prospector's business discovery.
GOOGLE_PLACES_API_KEY=

# DataForSEO — the search-volume backbone for watch terms. Both halves
# are required or the adapter is skipped.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional; raises the reader proxy's rate limit (lib/import/reader.ts).
JINA_API_KEY=
# Set to 1 to let the headless renderer wait out a JS challenge page.
# Off by default: waiting one out works around a site's access controls.
ALLOW_CHALLENGE_BYPASS=

# Reddit public JSON requires a descriptive User-Agent or it 429s
REDDIT_USER_AGENT=trnd-signal/0.1 (by /u/trnd)

# Bearer token protecting /api/cron/* — set the same value in Vercel Cron
CRON_SECRET=

# Public URL of the deployed site (used for magic-link redirects, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=
# Origin for OAuth redirects and email links; falls back to NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL=

# Stripe — billing switches on with the secret key + baseline price id.
# Webhook endpoint: POST /api/stripe/webhook (checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASELINE=
STRIPE_PRICE_PRO=

# Founder notifications — demo requests + new signups pushed where you look.
# Either (or both): a Slack/Discord/Zapier-style webhook, and/or email via Resend.
NOTIFY_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Sender for the weekly report email and alert digests.
EMAIL_FROM=

# Internal growth tools (/admin/prospector). ADMIN_EMAILS is the comma-
# separated allowlist of sign-in emails; empty means nobody gets in.
# OUTREACH_FROM is the founder sender for prospect emails (falls back to
# EMAIL_FROM). Discovery reuses GOOGLE_PLACES_API_KEY.
ADMIN_EMAILS=
OUTREACH_FROM=
# Set to 1 to turn on the cold-email prospector. Off by default: it mails
# businesses that never asked to hear from us.
PROSPECTOR_ENABLED=
