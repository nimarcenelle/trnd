# Supabase: Project Settings → API. Run supabase/migrations/0100_surveillance.sql once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: names the rivals, tags each ad, writes the reports.
OPENAI_API_KEY=
# Optional model pin (default gpt-5.5).
OPENAI_MODEL=

# Apify: reads public Instagram and TikTok profiles (without it, social is
# skipped), and is the fallback for the Ad Library read if Meta walls the
# server's IP. Actor overrides are optional.
APIFY_TOKEN=
APIFY_ADLIBRARY_ACTOR=
APIFY_INSTAGRAM_ACTOR=
APIFY_TIKTOK_ACTOR=
# Facebook Page posts, matched to ads for their likes, comments and shares (read every 3 days).
APIFY_FACEBOOK_POSTS_ACTOR=
# Apify cost controls (defaults in brackets): ads per company per paid read [25],
# days between paid ad reads per company [2], days between Instagram/TikTok
# reads [2], days between Facebook post reads [7]. Free reads stay daily.
APIFY_ADS_PER_RIVAL=
APIFY_EVERY_DAYS=
SOCIAL_EVERY_DAYS=
FACEBOOK_POSTS_EVERY_DAYS=
# TRND's scraper worker (worker/, deployed on Railway): a real Chrome behind a
# residential proxy, the first reader for the Ad Library. Same key on both sides.
SCRAPER_URL=
SCRAPER_KEY=
# Where data-health alerts go (fewer than 95% of companies read in a day, or the worker down).
OPS_EMAIL=

# Meta's official Ad Library API, the free fallback when Meta walls the direct
# read: a user access token (developers.facebook.com/tools/ad-library, after
# Meta confirms your ID). It covers ads shown in the EU. Long-lived tokens last
# about 60 days; the scan says so when it expires.
META_ACCESS_TOKEN=
META_API_VERSION=
# Ads read per rival per scan (default 50, max 200).
ADS_PER_RIVAL=

# Bearer token for /api/cron/scan; Vercel Cron sends it automatically.
CRON_SECRET=

# Public URL of the site (auth redirects, email links).
NEXT_PUBLIC_SITE_URL=

# Stripe: one subscription price. Webhook: POST /api/stripe/webhook
# (checkout.session.completed, customer.subscription.updated/deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE=

# Resend: the "your rivals changed their ads" email.
RESEND_API_KEY=
EMAIL_FROM=

# Competitor emails. Every rival gets an address on this domain; mail to it is
# posted to /api/inbound. With Resend: add the domain under Receiving, point a
# webhook (email.received) at https://<site>/api/inbound, and put its signing
# secret here. Any other service: post JSON {from, to, subject, text, html} to
# /api/inbound?secret=<INBOUND_SECRET>.
INBOUND_DOMAIN=
INBOUND_SECRET=
